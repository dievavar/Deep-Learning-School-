  {
   "cell_type": "markdown",
   "id": "4ef5f5a9-a01a-4286-a764-7076eb87c387",
   "metadata": {},
   "source": [
    "Эксперимент 1: добавить числовые фичи, ничего больше не менять\n",
    "\n",
    "**Гипотеза: “боты отличаются стилем и статистикой, не только словами”.**\n",
    "\n",
    "Меняем только одно: добавляем числовые признаки (длины, количества, пунктуация и т.п.).\n",
    "TF-IDF и модель остаются прежними"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 134,
   "id": "2f0be612-b010-43c5-b79f-7f1d288c2a94",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Числовые признаки из self_text \n",
    "_word_re = re.compile(r\"\\b\\w+\\b\", flags=re.UNICODE)\n",
    "\n",
    "def add_self_numeric_features(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df = df.copy()\n",
    "    s = df[\"self_text\"].fillna(\"\").astype(str)\n",
    "\n",
    "    # базовые\n",
    "    df[\"self_len_chars\"] = s.str.len()\n",
    "    df[\"self_len_lines\"] = s.str.count(r\"\\n\") + 1\n",
    "\n",
    "    # токены/слова\n",
    "    words = s.apply(lambda x: _word_re.findall(x.lower()))\n",
    "    df[\"self_n_words\"] = words.apply(len).astype(float)\n",
    "    df[\"self_unique_word_ratio\"] = words.apply(lambda w: (len(set(w)) / len(w)) if len(w) else 0.0).astype(float)\n",
    "    df[\"self_avg_word_len\"] = words.apply(lambda w: (np.mean([len(t) for t in w]) if len(w) else 0.0)).astype(float)\n",
    "\n",
    "    # “пунктуационный стиль”\n",
    "    df[\"self_cnt_q\"] = s.str.count(r\"\\?\").astype(float)\n",
    "    df[\"self_cnt_excl\"] = s.str.count(r\"!\").astype(float)\n",
    "    df[\"self_cnt_dots\"] = s.str.count(r\"\\.\").astype(float)\n",
    "    df[\"self_cnt_ellipsis\"] = s.str.count(r\"\\.\\.\\.\").astype(float)\n",
    "    df[\"self_cnt_commas\"] = s.str.count(r\",\").astype(float)\n",
    "\n",
    "    # доли (нормируем на длину, чтобы диалоги разной длины были сравнимы)\n",
    "    denom = (df[\"self_len_chars\"].replace(0, 1)).astype(float)\n",
    "    df[\"self_ratio_q\"] = df[\"self_cnt_q\"] / denom\n",
    "    df[\"self_ratio_excl\"] = df[\"self_cnt_excl\"] / denom\n",
    "    df[\"self_ratio_dots\"] = df[\"self_cnt_dots\"] / denom\n",
    "\n",
    "    # uppercase / digits\n",
    "    df[\"self_cnt_upper\"] = s.apply(lambda x: sum(ch.isupper() for ch in x)).astype(float)\n",
    "    df[\"self_cnt_digits\"] = s.apply(lambda x: sum(ch.isdigit() for ch in x)).astype(float)\n",
    "    df[\"self_ratio_upper\"] = df[\"self_cnt_upper\"] / denom\n",
    "    df[\"self_ratio_digits\"] = df[\"self_cnt_digits\"] / denom\n",
    "\n",
    "    # нормируем некоторые “счётчики” на число слов — иногда стабильнее\n",
    "    denom_w = (df[\"self_n_words\"].replace(0, 1)).astype(float)\n",
    "    df[\"self_q_per_word\"] = df[\"self_cnt_q\"] / denom_w\n",
    "    df[\"self_excl_per_word\"] = df[\"self_cnt_excl\"] / denom_w\n",
    "\n",
    "    # если у вас уже есть self_n_msgs/self_avg_msg_len — оставляем, это тоже фичи\n",
    "    if \"self_n_msgs\" not in df.columns:\n",
    "        df[\"self_n_msgs\"] = 0.0\n",
    "    if \"self_avg_msg_len\" not in df.columns:\n",
    "        df[\"self_avg_msg_len\"] = 0.0\n",
    "\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 136,
   "id": "c3574e67-6866-4aaf-9d1b-26d6cfef987d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Пайплайн: TF-IDF + numeric -> LR\n",
    "def make_model(numeric_cols):\n",
    "    pre = ColumnTransformer(\n",
    "        transformers=[\n",
    "            (\"txt\", TfidfVectorizer(\n",
    "                ngram_range=(1, 2),\n",
    "                min_df=2,\n",
    "                max_df=0.95,\n",
    "                sublinear_tf=True\n",
    "            ), \"self_text\"),\n",
    "            (\"num\", Pipeline(steps=[\n",
    "                (\"scaler\", StandardScaler())  # числовые фичи в сравнимый масштаб\n",
    "            ]), numeric_cols),\n",
    "        ],\n",
    "        remainder=\"drop\",\n",
    "        sparse_threshold=0.8\n",
    "    )\n",
    "\n",
    "    model = Pipeline(steps=[\n",
    "        (\"pre\", pre),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            max_iter=2000,\n",
    "            solver=\"liblinear\",\n",
    "            class_weight=\"balanced\"\n",
    "        ))\n",
    "    ])\n",
    "    return model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 137,
   "id": "39dac56e-220a-4c25-a511-5c4eaeb8d11f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3) CV LogLoss (GroupKFold)\n",
    "def cv_logloss_with_numeric(df: pd.DataFrame, n_splits: int = 5) -> float:\n",
    "    df = add_self_numeric_features(df)\n",
    "\n",
    "    # список числовых колонок (явно, чтобы контролировать эксперимент)\n",
    "    numeric_cols = [\n",
    "        \"self_n_msgs\", \"self_avg_msg_len\",\n",
    "        \"self_len_chars\", \"self_len_lines\",\n",
    "        \"self_n_words\", \"self_unique_word_ratio\", \"self_avg_word_len\",\n",
    "        \"self_ratio_q\", \"self_ratio_excl\", \"self_ratio_dots\",\n",
    "        \"self_ratio_upper\", \"self_ratio_digits\",\n",
    "        \"self_q_per_word\", \"self_excl_per_word\",\n",
    "        \"self_cnt_ellipsis\", \"self_cnt_commas\",\n",
    "    ]\n",
    "\n",
    "    X = df[[\"self_text\"] + numeric_cols]\n",
    "    y = df[\"is_bot\"].astype(int).values\n",
    "    groups = df[\"dialog_id\"].values\n",
    "\n",
    "    gkf = GroupKFold(n_splits=n_splits)\n",
    "    model = make_model(numeric_cols)\n",
    "\n",
    "    oof = np.zeros(len(df), dtype=float)\n",
    "    for tr_idx, va_idx in gkf.split(X, y, groups):\n",
    "        model.fit(X.iloc[tr_idx], y[tr_idx])\n",
    "        oof[va_idx] = model.predict_proba(X.iloc[va_idx])[:, 1]\n",
    "\n",
    "    oof = np.clip(oof, 1e-15, 1 - 1e-15)\n",
    "    return log_loss(y, oof)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 142,
   "id": "3427eb0b-ee68-4242-8931-9ed7a90253df",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train all + submit\n",
    "def train_and_submit_with_numeric(train_df: pd.DataFrame,\n",
    "                                  test_json_path: str,\n",
    "                                  ytest_csv_path: str,\n",
    "                                  out_path: str = \"submission_numeric.csv\") -> pd.DataFrame:\n",
    "    train_df = add_self_numeric_features(train_df)\n",
    "\n",
    "    numeric_cols = [\n",
    "        \"self_n_msgs\", \"self_avg_msg_len\",\n",
    "        \"self_len_chars\", \"self_len_lines\",\n",
    "        \"self_n_words\", \"self_unique_word_ratio\", \"self_avg_word_len\",\n",
    "        \"self_ratio_q\", \"self_ratio_excl\", \"self_ratio_dots\",\n",
    "        \"self_ratio_upper\", \"self_ratio_digits\",\n",
