    "def fit_predict_best(train_df, X_test):\n",
    "    X_train = train_df[\"self_text\"].fillna(\"\").values\n",
    "    y_train = train_df[\"is_bot\"].astype(int).values\n",
    "    model = make_best_model()\n",
    "    model.fit(X_train, y_train)\n",
    "    p = model.predict_proba(X_test)[:, 1]\n",
    "    return np.clip(p, 1e-15, 1 - 1e-15)\n",
    "\n",
    "# Собираем X_test и ids (как вы уже делали)\n",
    "test_dialogs = load_dialogs_json(\"you-are-bot/test.json\")\n",
    "test_feat = build_participant_df(test_dialogs)\n",
