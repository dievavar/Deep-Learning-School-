  {
   "cell_type": "markdown",
   "id": "804d9457-7e85-48c8-9120-5b29d6c01752",
   "metadata": {},
   "source": [
    "**Гипотеза: class_weight=\"balanced\" портит калибровку вероятностей**\n",
    "\n",
    "Для LogLoss это частый момент. balanced полезен, когда вам важна полнота по редкому классу, но он смещает оптимизацию и нередко делает вероятности хуже откалиброванными.\n",
    "\n",
    "Эксперимент: фиксируем всё (char_wb, ngram=(2,5), C=8) и меняем только class_weight:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 165,
   "id": "97ba02f3-6aa9-4739-8ca4-c66def511b3c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "balanced: 0.4680026488926592\n",
      "none    : 0.4540073632490548\n"
     ]
    }
   ],
   "source": [
    "def cv_logloss_char(df, C=8.0, class_weight=None, n_splits=5):\n",
    "    X = df[\"self_text\"].fillna(\"\").values\n",
    "    y = df[\"is_bot\"].astype(int).values\n",
    "    groups = df[\"dialog_id\"].values\n",
    "\n",
    "    model = Pipeline(steps=[\n",
    "        (\"tfidf\", TfidfVectorizer(\n",
    "            analyzer=\"char_wb\",\n",
    "            ngram_range=(2, 5),\n",
    "            min_df=2,\n",
    "            max_df=0.95,\n",
    "            sublinear_tf=True\n",
    "        )),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            C=C,\n",
    "            max_iter=4000,\n",
    "            solver=\"liblinear\",\n",
    "            class_weight=class_weight\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    gkf = GroupKFold(n_splits=n_splits)\n",
    "    oof = np.zeros(len(df), dtype=float)\n",
    "\n",
    "    for tr_idx, va_idx in gkf.split(X, y, groups):\n",
    "        model.fit(X[tr_idx], y[tr_idx])\n",
    "        oof[va_idx] = model.predict_proba(X[va_idx])[:, 1]\n",
    "\n",
    "    oof = np.clip(oof, 1e-15, 1 - 1e-15)\n",
    "    return log_loss(y, oof)\n",
    "\n",
    "print(\"balanced:\", cv_logloss_char(train_df, C=8.0, class_weight=\"balanced\"))\n",
    "print(\"none    :\", cv_logloss_char(train_df, C=8.0, class_weight=None))\n"
   ]
  },
