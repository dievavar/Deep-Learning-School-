    "# Запуск сравнения\n",
    "train_df = load_train_df(\"you-are-bot/train.json\", \"you-are-bot/ytrain.csv\")\n",
    "\n",
    "for mode in [\"self\", \"concat\", \"marked\"]:\n",
    "    score = cv_logloss_text_only(train_df, mode, n_splits=5)\n",
