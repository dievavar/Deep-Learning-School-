   "source": [
    "## Сборка датасета"
   ]
  }
  {
   "cell_type": "markdown",
   "id": "3393481d-7a25-4f04-bda5-e79c47b44d5c",
   "metadata": {},
   "source": [
    "LogLoss + GroupKFold (результаты):\n",
    "\n",
    "| Эксперимент | Метод | Основные настройки | CV LogLoss ↓ | Public LB LogLoss ↓ | Вывод |\n",
    "|---:|---|---|---:|---:|---|\n",
    "| 1 | Baseline | `self_text` + word TF-IDF (1–2) + LogisticRegression, GroupKFold(dialog_id) | 0.526 | 0.521 | Базовый ориентир; CV и LB одного порядка → валидация выглядит адекватной. |\n",
    "| 2 | + Числовые признаки | Baseline + numeric (длины/пунктуация/доли и т.п.) | 0.543 | 0.526 | Ухудшение: в прямом сложении с TF-IDF признаки добавляют шум и/или портят калибровку вероятностей. |\n",
    "| 3 | Char-TFIDF | `char_wb`, ngram_range=(2,5) + LogisticRegression | 0.521 | 0.520 | Улучшение: символьные n-граммы лучше ловят паттерны “ботности”, чем word-TFIDF. |\n",
    "| 4 | Подбор регуляризации | Char-TFIDF (2,5) + LogisticRegression, `C=8`, `class_weight=\"balanced\"` | 0.468 | 0.484 | Существенный выигрыш: baseline ограничивала слишком сильная регуляризация. |\n",
    "| 5 | Убрать `class_weight` | Char-TFIDF (2,5) + LogisticRegression, `C=8`, `class_weight=None` | 0.454 | 0.487 | На CV лучше, но на public хуже → возможен prior shift между train/test или шум public. |\n",
    "| 6 | Сдвиг логитов | Применение к вероятностям: `p' = sigmoid(logit(p) + b)` | 0.454 | 0.486 | Небольшое улучшение (~0.001) → проблема не сводится к простому сдвигу вероятностей. |\n",
    " "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 141,
   "id": "cebfb0fc-d0f5-4737-bfd1-2bed17bbb62e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.metrics import log_loss\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "RANDOM_STATE = 42"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "id": "24354656-bc4a-4df5-bbbc-67d863a7dbea",
   "metadata": {},
   "outputs": [],
   "source": [
    "# чтение json файла\n",
    "def load_dialogs_json(path: str) -> dict:\n",
    "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
    "        return json.load(f)        "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 104,
   "id": "f496ec8e-6967-4191-aece-42de5ec82bb7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_participant_df(dialogs: dict) -> pd.DataFrame:\n",
    "    rows = []\n",
    "    for dialog_id, messages in dialogs.items():\n",
    "        msgs = sorted(messages, key=lambda x: x[\"message\"])\n",
    "\n",
    "        by_p = {0: [], 1: []}\n",
    "        for m in msgs:\n",
    "            p = int(m[\"participant_index\"])\n",
    "            text = (m.get(\"text\") or \"\")\n",
    "            by_p[p].append((m[\"message\"], text))\n",
    "\n",
    "        for p in [0, 1]:\n",
    "            other = 1 - p\n",
    "            self_texts = [t for _, t in by_p[p]]\n",
    "            other_texts = [t for _, t in by_p[other]]\n",
    "\n",
    "            self_text = \"\\n\".join(self_texts).strip()\n",
    "            other_text = \"\\n\".join(other_texts).strip()\n",
    "\n",
    "            rows.append({\n",
    "                \"dialog_id\": str(dialog_id),\n",
    "                \"participant_index\": int(p),\n",
    "                \"self_text\": self_text,\n",
    "                \"other_text\": other_text,\n",
    "            })\n",
    "    return pd.DataFrame(rows)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 105,
   "id": "4968f058-583b-435c-bc25-539bd8a8b3d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_text_column(df: pd.DataFrame, mode: str) -> pd.Series:\n",
    "    if mode == \"self\":\n",
    "        return df[\"self_text\"].fillna(\"\")\n",
    "    if mode == \"concat\":\n",
    "        return (df[\"self_text\"].fillna(\"\") + \"\\n\" + df[\"other_text\"].fillna(\"\")).str.strip()\n",
    "    if mode == \"marked\":\n",
    "        return (\"[SELF]\\n\" + df[\"self_text\"].fillna(\"\") + \"\\n[OTHER]\\n\" + df[\"other_text\"].fillna(\"\")).str.strip()\n",
    "    raise ValueError(f\"Unknown mode: {mode}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 106,
   "id": "3c897329-9604-4f87-bb76-6320e0386be2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_train_df(train_json_path: str, ytrain_csv_path: str) -> pd.DataFrame:\n",
    "    dialogs = load_dialogs_json(train_json_path)\n",
    "    df = build_participant_df(dialogs)\n",
    "\n",
    "    y = pd.read_csv(ytrain_csv_path)\n",
    "    y[\"dialog_id\"] = y[\"dialog_id\"].astype(str)\n",
    "    y[\"participant_index\"] = y[\"participant_index\"].astype(int)\n",
    "\n",
    "    df = df.merge(y, on=[\"dialog_id\", \"participant_index\"], how=\"inner\")\n",
    "    assert df[\"is_bot\"].notna().all()\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 108,
   "id": "7b907f9f-b33c-48c1-869e-6f5a6032cdfc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# CV под LogLoss\n",
    "def cv_logloss_text_only(df: pd.DataFrame, text_mode: str, n_splits: int = 5) -> float:\n",
    "    X_text = make_text_column(df, text_mode).values\n",
    "    y = df[\"is_bot\"].values.astype(int)\n",
    "    groups = df[\"dialog_id\"].values\n",
    "\n",
    "    gkf = GroupKFold(n_splits=n_splits)\n",
    "\n",
    "    model = Pipeline(steps=[\n",
    "        (\"tfidf\", TfidfVectorizer(\n",
    "            ngram_range=(1, 2),\n",
    "            min_df=2,\n",
    "            max_df=0.95,\n",
    "            sublinear_tf=True\n",
    "        )),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            max_iter=2000,\n",
    "            solver=\"liblinear\",\n",
    "            class_weight=\"balanced\"\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    oof = np.zeros(len(df), dtype=float)\n",
    "\n",
    "    for fold, (tr_idx, va_idx) in enumerate(gkf.split(X_text, y, groups), 1):\n",
    "        model.fit(X_text[tr_idx], y[tr_idx])\n",
    "        oof[va_idx] = model.predict_proba(X_text[va_idx])[:, 1]\n",
    "\n",
    "    # Клип — чисто технически, чтобы log_loss не взрывался на 0/1\n",
    "    eps = 1e-15\n",
    "    oof = np.clip(oof, eps, 1 - eps)\n",
    "\n",
    "    score = log_loss(y, oof) \n",
    "    return score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 121,
   "id": "a752a766-9657-4ff1-a2f0-0c4d8e224583",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train all + submit\n",
    "def train_and_predict_submit(train_df: pd.DataFrame,\n",
    "                             test_json_path: str,\n",
    "                             ytest_csv_path: str,\n",
    "                             text_mode: str,\n",
    "                             out_path: str = \"submission.csv\") -> pd.DataFrame:\n",
    "    test_dialogs = load_dialogs_json(test_json_path)\n",
    "    test_df = build_participant_df(test_dialogs)\n",
    "\n",
    "    ytest = pd.read_csv(ytest_csv_path)\n",
    "    ytest[\"dialog_id\"] = ytest[\"dialog_id\"].astype(str)\n",
    "    ytest[\"participant_index\"] = ytest[\"participant_index\"].astype(int)\n",
    "\n",
    "    test_df = test_df.merge(ytest, on=[\"dialog_id\", \"participant_index\"], how=\"inner\")\n",
    "    assert test_df[\"ID\"].notna().all()\n",
    "\n",
    "    X_train = make_text_column(train_df, text_mode).values\n",
    "    y_train = train_df[\"is_bot\"].values.astype(int)\n",
    "    X_test = make_text_column(test_df, text_mode).values\n",
    "\n",
    "    model = Pipeline(steps=[\n",
    "        (\"tfidf\", TfidfVectorizer(\n",
    "            ngram_range=(1, 2),\n",
    "            min_df=2,\n",
    "            max_df=0.95,\n",
    "            sublinear_tf=True\n",
    "        )),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            max_iter=2000,\n",
    "            solver=\"liblinear\",\n",
    "            class_weight=\"balanced\"\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    model.fit(X_train, y_train)\n",
    "    if len(X_test) == 0:\n",
    "        raise ValueError(\"X_test is empty right before predict_proba\")\n",
    "\n",
    "\n",
    "    pred = model.predict_proba(X_test)[:, 1]\n",
    "    pred = np.clip(pred, 1e-15, 1 - 1e-15)\n",
    "\n",
    "    sub = pd.DataFrame({\"ID\": test_df[\"ID\"].values, \"is_bot\": pred})\n",
    "    sub.to_csv(out_path, index=False)\n",
    "    return sub"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 123,
   "id": "17ac91b6-2412-4c83-891d-4d9f8bafb2b8",
