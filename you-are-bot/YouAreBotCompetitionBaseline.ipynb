    "Эксперимент 2: поменять TF-IDF (например, char n-grams), без числовых фич\n",
    "\n",
    "**Гипотеза: “символьные паттерны лучше ловят ботность”**\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 154,
   "id": "38663dcc-0226-428c-aa38-35b5d6911d19",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.metrics import log_loss\n",
    "import numpy as np\n",
    "\n",
    "def cv_logloss_char_tfidf(df, n_splits=5):\n",
    "    X = df[\"self_text\"].fillna(\"\").values\n",
    "    y = df[\"is_bot\"].astype(int).values\n",
    "    groups = df[\"dialog_id\"].values\n",
    "\n",
    "    model = Pipeline(steps=[\n",
    "        (\"tfidf\", TfidfVectorizer(\n",
    "            analyzer=\"char_wb\",      \n",
    "            ngram_range=(3, 5),     \n",
    "            min_df=2,\n",
    "            max_df=0.95,\n",
    "            sublinear_tf=True\n",
    "        )),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            max_iter=2000,\n",
    "            solver=\"liblinear\",\n",
    "            class_weight=\"balanced\"\n",
    "        ))\n",
    "    ])\n",
    "\n",
    "    gkf = GroupKFold(n_splits=n_splits)\n",
    "    oof = np.zeros(len(df), dtype=float)\n",
    "\n",
    "    for tr_idx, va_idx in gkf.split(X, y, groups):\n",
    "        model.fit(X[tr_idx], y[tr_idx])\n",
    "        oof[va_idx] = model.predict_proba(X[va_idx])[:, 1]\n",
    "\n",
    "    oof = np.clip(oof, 1e-15, 1 - 1e-15)\n",
    "    return log_loss(y, oof)"
   ]
  },
