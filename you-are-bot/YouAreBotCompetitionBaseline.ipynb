    "**Оптимальный сдвиг логитов (logit shift)**\n",
    "\n",
    "Это не меняет ранжирование, но меняет “склонность” модели к классу 1 (бот)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 174,
   "id": "4114c526-1f9a-453b-ad99-eff56fea6a94",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best b: 0.03499999999999989\n",
      "OOF LogLoss (shifted): 0.4539250089451465\n"
     ]
    }
   ],
   "source": [
    "def sigmoid(z):\n",
    "    return 1.0 / (1.0 + np.exp(-z))\n",
    "\n",
    "def logit(p):\n",
    "    p = np.clip(p, 1e-15, 1 - 1e-15)\n",
    "    return np.log(p / (1 - p))\n",
    "\n",
    "def apply_logit_shift(p, b):\n",
    "    return np.clip(sigmoid(logit(p) + b), 1e-15, 1 - 1e-15)\n",
    "\n",
    "def find_best_b(p_oof, y):\n",
    "    # грубая сетка\n",
    "    grid = np.linspace(-2.0, 2.0, 161)  # шаг 0.025\n",
    "    losses = []\n",
    "    for b in grid:\n",
    "        losses.append(log_loss(y, apply_logit_shift(p_oof, b)))\n",
    "    i = int(np.argmin(losses))\n",
    "    b0 = grid[i]\n",
    "\n",
    "    # уточнение вокруг лучшего\n",
    "    fine = np.linspace(b0 - 0.2, b0 + 0.2, 161)\n",
    "    best_b, best_ll = None, None\n",
    "    for b in fine:\n",
    "        ll = log_loss(y, apply_logit_shift(p_oof, b))\n",
    "        if best_ll is None or ll < best_ll:\n",
    "            best_b, best_ll = b, ll\n",
    "    return best_b, best_ll\n",
    "\n",
    "b_best, ll_shift = find_best_b(p_oof, y)\n",
    "print(\"Best b:\", b_best)\n",
    "print(\"OOF LogLoss (shifted):\", ll_shift)"
   ]
  },
